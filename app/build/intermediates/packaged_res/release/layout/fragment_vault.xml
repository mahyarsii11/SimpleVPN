<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <!-- Tunnel status badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:background="@drawable/bg_pill_badge"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
        android:paddingEnd="12dp">

            <View
                android:id="@+id/tunnel_badge_dot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/dot_cyan" />

            <TextView
                android:id="@+id/tunnel_badge_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/jetbrains_mono_600"
                android:letterSpacing="0.18"
                android:text="@string/badge_active"
                android:textColor="@color/badge_text"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Holographic globe -->
        <com.mahyar.simplevpn.GlobeView
            android:id="@+id/globe"
            android:layout_width="278dp"
            android:layout_height="252dp"
            android:layout_marginTop="4dp" />

        <!-- Power core -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">

            <View
                android:layout_width="148dp"
                android:layout_height="148dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_power_glow" />

            <FrameLayout
                android:id="@+id/power_ring"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_power_ring"
                android:padding="3dp">

                <FrameLayout
                    android:id="@+id/power_button"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_power_btn"
                    android:foreground="@drawable/bg_power_press">

                    <ImageView
                        android:id="@+id/power_icon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/connect"
                        android:src="@drawable/ic_power"
                        app:tint="@color/cyan_glow" />
                </FrameLayout>
            </FrameLayout>
        </FrameLayout>

        <!-- State + timer -->
        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/jetbrains_mono_600"
            android:letterSpacing="0.22"
            android:text="@string/state_connected"
            android:textColor="@color/cyan_glow"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="@string/timer"
                android:src="@drawable/ic_timer"
                app:tint="@color/primary_alpha" />

            <TextView
                android:id="@+id/session_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/jetbrains_mono_400"
                android:letterSpacing="0.2"
                android:text="00:00:00"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Metrics -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_metrics"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingStart="8dp"
        android:paddingEnd="8dp"
            android:paddingTop="12dp"
        android:paddingBottom="12dp">

            <LinearLayout style="@style/MetricCell">

                <LinearLayout style="@style/MetricLabelRow">
                    <ImageView
                        style="@style/MetricIcon"
                        android:contentDescription="@string/down"
                        android:src="@drawable/ic_down" />
                    <TextView
                        style="@style/MetricLabel"
                        android:text="@string/down" />
                </LinearLayout>

                <TextView
                    android:id="@+id/metric_down"
                    style="@style/MetricValue"
                    android:text="@string/metric_idle" />

                <TextView
                    style="@style/MetricUnit"
                    android:text="@string/mbps" />
            </LinearLayout>

            <View style="@style/MetricDivider" />

            <LinearLayout style="@style/MetricCell">

                <LinearLayout style="@style/MetricLabelRow">
                    <ImageView
                        style="@style/MetricIcon"
                        android:contentDescription="@string/up"
                        android:src="@drawable/ic_up" />
                    <TextView
                        style="@style/MetricLabel"
                        android:text="@string/up" />
                </LinearLayout>

                <TextView
                    android:id="@+id/metric_up"
                    style="@style/MetricValue"
                    android:text="@string/metric_idle" />

                <TextView
                    style="@style/MetricUnit"
                    android:text="@string/mbps" />
            </LinearLayout>

            <View style="@style/MetricDivider" />

            <LinearLayout style="@style/MetricCell">

                <LinearLayout style="@style/MetricLabelRow">
                    <ImageView
                        style="@style/MetricIcon"
                        android:contentDescription="@string/privacy"
                        android:src="@drawable/ic_verified" />
                    <TextView
                        style="@style/MetricLabel"
                        android:text="@string/privacy" />
                </LinearLayout>

                <TextView
                    style="@style/MetricValue"
                    android:text="@string/no_logs"
                    android:textColor="@color/cyan_glow"
                    android:textSize="14sp" />

                <TextView
                    style="@style/MetricUnit"
                    android:text="@string/audited" />
            </LinearLayout>
        </LinearLayout>

        <!-- Server selector card -->
        <LinearLayout
            android:id="@+id/server_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_server_card"
            android:foreground="@drawable/bg_card_press"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_flag_frame"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/card_flag"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/flag"
                    android:scaleType="fitXY"
                    android:src="@drawable/flag_de" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/card_city"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/space_grotesk_700"
                        android:text="@string/default_city"
                        android:textColor="@color/text_main"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/card_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_code_tag"
                        android:fontFamily="@font/jetbrains_mono_400"
                        android:paddingStart="6dp"
        android:paddingEnd="6dp"
                        android:paddingTop="1dp"
        android:paddingBottom="1dp"
                        android:text="@string/default_code"
                        android:textColor="@color/text_dim"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/dot_cyan" />

                    <TextView
                        android:id="@+id/card_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:maxLines="1"
                        android:text="@string/card_sub_default"
                        android:textColor="@color/cyan_soft"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ping_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
        android:paddingEnd="10dp"
                    android:paddingTop="4dp"
        android:paddingBottom="4dp">

                    <TextView
                        android:id="@+id/card_ping"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jetbrains_mono_600"
                        android:text="@string/ping_untested"
                        android:textColor="@color/primary_light"
                        android:textSize="11sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chevron_circle">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/change_server"
                        android:src="@drawable/ic_chevron"
                        app:tint="@color/text_dim" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
