<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_node_card"
    android:foreground="@drawable/bg_card_press"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
        android:paddingEnd="14dp"
    android:paddingTop="12dp"
        android:paddingBottom="12dp">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_flag_frame">

            <ImageView
                android:id="@+id/item_flag"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:contentDescription="@string/flag"
                android:scaleType="fitXY" />
        </FrameLayout>

        <TextView
            android:id="@+id/item_rank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|top"
            android:background="@drawable/bg_rank_pill"
            android:fontFamily="@font/jetbrains_mono_600"
            android:paddingStart="5dp"
        android:paddingEnd="5dp"
            android:text="@string/rank_default"
            android:textColor="@color/text_main"
            android:textSize="9sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/item_city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/space_grotesk_700"
                android:textColor="@color/text_main"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/item_connected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_connected_pill"
                android:fontFamily="@font/jetbrains_mono_600"
                android:letterSpacing="0.1"
                android:paddingStart="6dp"
        android:paddingEnd="6dp"
                android:paddingTop="1dp"
        android:paddingBottom="1dp"
                android:text="@string/connected_tag"
                android:textColor="@color/green"
                android:textSize="9sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/item_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/jetbrains_mono_400"
            android:maxLines="1"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@string/ping"
                android:src="@drawable/ic_signal"
                app:tint="@color/text_dim" />

            <TextView
                android:id="@+id/item_ping"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="@font/jetbrains_mono_600"
                android:text="@string/ping_dash"
                android:textColor="@color/text_main"
                android:textSize="14sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/item_select_btn"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="end"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_select_btn_idle">

            <ImageView
                android:id="@+id/item_selected"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="center"
                android:contentDescription="@string/select"
                android:src="@drawable/ic_power"
                app:tint="@color/text_dim" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
