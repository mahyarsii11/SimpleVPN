<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="16dp" />

        <Button
            android:id="@+id/btn_warp"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/warp_connect"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_off"
            android:textSize="15sp"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33888888"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vg_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/btn_refresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vg_refresh" />

        <ListView
            android:id="@+id/country_list"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/vg_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vg_note"
            android:textSize="13sp"
            android:paddingTop="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/footer"
            android:textSize="12sp"
            android:paddingTop="14dp"
            android:gravity="center" />

    </LinearLayout>
</ScrollView>
