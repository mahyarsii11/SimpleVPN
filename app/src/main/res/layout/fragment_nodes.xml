<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_nodes"
    android:orientation="vertical"
    android:paddingStart="16dp"
        android:paddingEnd="16dp">

    <!-- Search row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
        android:paddingEnd="14dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/search"
                android:src="@drawable/ic_search"
                app:tint="@color/text_dim" />

            <EditText
                android:id="@+id/server_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="sans-serif"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/text_main"
                android:textColorHint="@color/outline"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_code_tag"
                android:fontFamily="@font/jetbrains_mono_400"
                android:paddingStart="8dp"
        android:paddingEnd="8dp"
                android:paddingTop="2dp"
        android:paddingBottom="2dp"
                android:text="@string/node_count"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_filter_btn">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/filter"
                android:src="@drawable/ic_tune"
                app:tint="@color/text_dim" />
        </FrameLayout>
    </LinearLayout>

    <!-- Live telemetry banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/dot_green" />

        <TextView
            android:id="@+id/telemetry_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/jetbrains_mono_400"
            android:text="@string/telemetry_synced"
            android:textColor="@color/text_dim"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/test_pings"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_test_btn"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
        android:paddingEnd="12dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@string/test_pings"
                android:src="@drawable/ic_bolt"
                app:tint="@color/text_dim" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/jetbrains_mono_600"
                android:text="@string/test_pings"
                android:textColor="@color/text_main"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Section title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:contentDescription="@string/fastest"
            android:src="@drawable/ic_verified"
            app:tint="@color/text_dim" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:fontFamily="@font/space_grotesk_700"
            android:letterSpacing="0.06"
            android:text="@string/fastest"
            android:textColor="@color/text_main"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_code_tag"
            android:fontFamily="@font/jetbrains_mono_400"
            android:paddingStart="8dp"
        android:paddingEnd="8dp"
            android:paddingTop="2dp"
        android:paddingBottom="2dp"
            android:text="@string/auto_select"
            android:textColor="@color/text_dim"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Node list -->
    <ListView
        android:id="@+id/node_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:listSelector="@android:color/transparent"
        android:overScrollMode="never"
        android:paddingBottom="10dp"
        android:scrollbars="none" />

    <!-- Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/dot_green" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:fontFamily="@font/jetbrains_mono_400"
            android:letterSpacing="0.1"
            android:text="@string/footer_guard"
            android:textColor="@color/text_dim"
            android:textSize="10sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono_400"
            android:text="@string/footer_wireguard"
            android:textColor="@color/outline"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
