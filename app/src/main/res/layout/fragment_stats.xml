<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/space_grotesk_700"
            android:letterSpacing="0.06"
            android:text="@string/stats_title"
            android:textColor="@color/text_main"
            android:textSize="16sp" />

        <!-- Session card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_soft"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/stats_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jetbrains_mono_600"
                android:letterSpacing="0.2"
                android:text="@string/state_disconnected"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/stats_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/jetbrains_mono_600"
                android:text="00:00:00"
                android:textColor="@color/text_main"
                android:textSize="34sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/jetbrains_mono_400"
                android:text="@string/session_time"
                android:textColor="@color/text_dim"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Traffic card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_soft"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono_400"
                    android:letterSpacing="0.14"
                    android:text="@string/total_down"
                    android:textColor="@color/text_dim"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/stats_down"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/jetbrains_mono_600"
                    android:text="@string/metric_idle"
                    android:textColor="@color/text_main"
                    android:textSize="17sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/divider" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono_400"
                    android:letterSpacing="0.14"
                    android:text="@string/total_up"
                    android:textColor="@color/text_dim"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/stats_up"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/jetbrains_mono_600"
                    android:text="@string/metric_idle"
                    android:textColor="@color/text_main"
                    android:textSize="17sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Node card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_soft"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono_400"
                    android:letterSpacing="0.14"
                    android:text="@string/selected_node"
                    android:textColor="@color/text_dim"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/stats_node"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/space_grotesk_700"
                    android:textColor="@color/text_main"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ping_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
        android:paddingEnd="10dp"
                android:paddingTop="4dp"
        android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/stats_ping"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono_600"
                    android:text="@string/ping_untested"
                    android:textColor="@color/primary_light"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/jetbrains_mono_400"
            android:lineSpacingExtra="4dp"
            android:text="@string/stats_note"
            android:textColor="@color/outline"
            android:textSize="10.5sp" />
    </LinearLayout>
</ScrollView>
